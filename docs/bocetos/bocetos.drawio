;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#666666;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="58" y="770" width="480" height="26" as="geometry"/></mxCell><mxCell id="pg7-41" value="← AQUÍ aparece el mensaje de resultado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B7F3B;strokeWidth=2;fontSize=13;fontColor=#0F4D22;align=center;verticalAlign=middle;fontStyle=0;dashed=1;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="58" y="808" width="484" height="52" as="geometry"/></mxCell><mxCell id="pg7-42" value="Reservar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B3D4F;strokeColor=#0B3D4F;strokeWidth=1.5;fontSize=16;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontStyle=1;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1"><mxGeometry x="58" y="880" width="484" height="50" as="geometry"/></mxCell><mxCell id="pg7-43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#F2A900;strokeWidth=1.5;fontSize=14;fontColor=#1A1A1A;align=center;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="735" width="740" height="220" as="geometry"/></mxCell><mxCell id="pg7-44" value="Notas de diseño y accesibilidad" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#1A1A1A;fontStyle=1;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="638" y="745" width="500" height="29" as="geometry"/></mxCell><mxCell id="pg7-45" value="• Cada estado usa icono + texto, no solo color." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13.5;fontColor=#1A1A1A;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="638" y="780" width="700" height="27" as="geometry"/></mxCell><mxCell id="pg7-46" value="• El mensaje se anuncia a lectores de pantalla (role=&quot;alert&quot;)." styl